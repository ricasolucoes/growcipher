default_platform(:android)

PROJECT_ROOT = File.expand_path("..", __dir__)

platform :android do
  desc "Build and publish GrowCipher to Google Play Store"
  lane :deploy do |options|
    track = options[:track] || 'production'

    sh("cd .. && flutter build appbundle --release")

    upload_to_play_store(
      track: track,
      aab: '../build/app/outputs/bundle/release/app-release.aab',
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: '/Users/sierra/Dev/keystores/play-store-api-key.json',
      package_name: 'com.sierratecnologia.growcipher'
    )
  end

  desc "Sync Store Metadata only"
  lane :sync_metadata do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: '/Users/sierra/Dev/keystores/play-store-api-key.json',
      package_name: 'com.sierratecnologia.growcipher'
    )
  end
end

platform :ios do
  private_lane :growcipher_app_store_connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_CONNECT_API_PRIVATE_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Build, sign and export the GrowCipher iOS IPA"
  lane :build do
    team_id = ENV.fetch("APPLE_TEAM_ID", "28X7P94SF5")
    bundle_id = ENV.fetch("IOS_BUNDLE_ID", "com.sierratecnologia.growcipher")
    profile_name = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
    version_name = ENV.fetch("VERSION_NAME")
    build_number = ENV.fetch("BUILD_NUMBER")
    # The binary marketing version comes from pubspec.yaml. IOS_APP_STORE_VERSION
    # identifies the App Store Connect version record and must never rewrite the
    # version users see in the installed app.
    binary_version_name = ENV.fetch("IOS_BINARY_VERSION_NAME", version_name)

    sh("cd #{PROJECT_ROOT} && flutter build ios --release --no-codesign --verbose --build-name #{binary_version_name} --build-number #{build_number}")

    gym(
      workspace: File.join(PROJECT_ROOT, "ios/Runner.xcworkspace"),
      scheme: "Runner",
      configuration: "Release",
      clean: true,
      output_directory: File.join(PROJECT_ROOT, "build/ios"),
      output_name: "GrowCipher.ipa",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          bundle_id => profile_name
        }
      }
    )
  end

  desc "Upload the signed IPA to TestFlight"
  lane :upload_testflight do
    pilot(
      api_key: growcipher_app_store_connect_api_key,
      ipa: File.join(PROJECT_ROOT, "build/ios/GrowCipher.ipa"),
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Upload the signed IPA and metadata to App Store Connect"
  lane :upload_appstore do
    deliver(
      api_key: growcipher_app_store_connect_api_key,
      ipa: File.join(PROJECT_ROOT, "build/ios/GrowCipher.ipa"),
      app_identifier: ENV.fetch("IOS_BUNDLE_ID", "com.sierratecnologia.growcipher"),
      app_version: ENV.fetch("IOS_APP_STORE_VERSION", ENV.fetch("VERSION_NAME")),
      metadata_path: File.join(PROJECT_ROOT, "fastlane/metadata/ios"),
      screenshots_path: File.join(PROJECT_ROOT, "fastlane/screenshots"),
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: ENV.fetch("IOS_SUBMIT_FOR_REVIEW", "false") == "true",
      automatic_release: ENV.fetch("IOS_AUTOMATIC_RELEASE", "true") == "true",
      force: true,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name: ENV.fetch("IOS_REVIEW_FIRST_NAME", "Ricardo"),
        last_name: ENV.fetch("IOS_REVIEW_LAST_NAME", "Sierra"),
        phone_number: ENV.fetch("IOS_REVIEW_PHONE", "+55 21 99919-3898"),
        email_address: ENV.fetch("IOS_REVIEW_EMAIL", "sierra.csi@gmail.com"),
        notes: <<~REVIEW_NOTES
          GrowCipher — App Review Information

          1. Screen recording
          Attach a screen recording made on a physical iPhone running the latest supported iOS. It starts on the Home Screen, launches GrowCipher, creates a plant, records a growth event, opens the plant timeline, and returns to the main screen. GrowCipher has no account registration, login, account deletion, user-generated public content, reporting/blocking flow, advertisements, in-app purchases, subscriptions, or paid features.

          2. Purpose and target audience
          GrowCipher is a privacy-first, offline-first grow journal for hobby growers, indoor gardeners, and independent cultivators. It solves the problem of keeping plant, cycle, and growth-event records without requiring an account or sending cultivation data to a cloud service. It provides a private local timeline, structured records, and simple progress insights that remain under the user's control.

          3. Setup and access
          Install and launch the app, then tap the action to add a plant. Follow the on-device wizard, save the plant, and use the quick-log actions to record watering, observation, treatment, or harvest events. Open any plant to review its timeline and progress. No account, credentials, invitation, sample file, or special setup is required; all main features are available immediately after installation and all records are stored locally on the device.

          4. External services, tools, and platforms
          The core functionality uses Flutter and the iOS SQLite storage provided through the sqflite plugin. The app does not use authentication, remote APIs, cloud storage, analytics, advertising, tracking, social networks, AI services, payment processors, or other third-party data providers. Apple services are used only for App Store distribution and TestFlight delivery.

          5. Regional differences
          The app's features, data handling, and content are consistent worldwide. The interface is localized for Brazilian Portuguese, English, and Spanish; localization is the only regional variation. GrowCipher is a private record-keeping tool and does not provide regulated medical, financial, legal, or agricultural certification.

          6. Regulated industry and third-party material
          GrowCipher is not a regulated service and does not provide medical treatment, financial services, gambling, or controlled-substance transactions. It does not include protected third-party media or user-generated public content. The app's code and interface are owned or properly licensed by Sierra Tecnologia LTDA. No authorization credentials or special documentation are required.

          Additional review answers
          - Accounts: none; no registration, login, profile, or account-deletion flow exists, so no demo credentials are needed.
          - User-generated content: records are private local data only; users cannot publish, contact, report, or block other users.
          - Paid content: none; there are no purchases, subscriptions, ads, or paywalls.
          - Business model: general consumer app, not restricted to a business, organization, or employee group.
        REVIEW_NOTES
      },
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: ENV.fetch("IOS_EXPORT_COMPLIANCE_USES_ENCRYPTION").casecmp("true").zero?,
        export_compliance_is_exempt: ENV.fetch("IOS_EXPORT_COMPLIANCE_IS_EXEMPT").casecmp("true").zero?,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: false
      }
    )
  end
end
